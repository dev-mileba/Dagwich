"""Read and validate CSV records using the generated target schema."""

import csv
from datetime import date, datetime, timezone
from decimal import Decimal, InvalidOperation
from pathlib import Path
from typing import Any

from .schema import COLUMNS


class CsvInputError(ValueError):
    """Raised when a CSV file does not match the generated schema."""


def _convert_value(value: str | None, column: dict[str, Any]) -> Any:
    if value is None:
        raise ValueError("CSV row is missing a field value")
    if not value.strip():
        if column["primary_key"]:
            raise ValueError("primary key value cannot be empty")
        return None

    normalized = value.strip()
    sql_type = column["sql_type"]

    if sql_type == "TEXT":
        return normalized
    if sql_type in {"INTEGER", "BIGINT"}:
        converted = int(normalized)
        if sql_type == "INTEGER" and not -(2**31) <= converted < 2**31:
            raise ValueError("value is outside the INTEGER range")
        if sql_type == "BIGINT" and not -(2**63) <= converted < 2**63:
            raise ValueError("value is outside the BIGINT range")
        return converted
    if sql_type == "NUMERIC":
        converted = Decimal(normalized)
        if not converted.is_finite():
            raise ValueError("value must be a finite number")
        return converted
    if sql_type == "BOOLEAN":
        boolean_values = {
            "true": True,
            "t": True,
            "1": True,
            "yes": True,
            "false": False,
            "f": False,
            "0": False,
            "no": False,
        }
        try:
            return boolean_values[normalized.lower()]
        except KeyError as error:
            raise ValueError("expected true/false, t/f, 1/0, or yes/no") from error
    if sql_type == "DATE":
        return date.fromisoformat(normalized)
    if sql_type == "TIMESTAMPTZ":
        converted = datetime.fromisoformat(normalized.replace("Z", "+00:00"))
        if converted.utcoffset() is None:
            raise ValueError("timestamp must include a timezone")
        return converted.astimezone(timezone.utc)

    raise ValueError(f"unsupported SQL type {sql_type!r}")


def read_csv(path: str | Path) -> list[dict[str, Any]]:
    """Read, normalize, and validate every row; fail with row context on bad input."""
    csv_path = Path(path)
    expected_columns = [column["name"] for column in COLUMNS]
    records: list[dict[str, Any]] = []

    with csv_path.open(encoding="utf-8", newline="") as input_file:
        reader = csv.DictReader(input_file, restkey="__extra_csv_values__")
        headers = reader.fieldnames
        if headers is None:
            raise CsvInputError(f"{csv_path}: missing CSV header")
        if len(headers) != len(set(headers)):
            raise CsvInputError(f"{csv_path}: duplicate column names in CSV header")

        missing_columns = [name for name in expected_columns if name not in headers]
        extra_columns = [name for name in headers if name not in expected_columns]
        if missing_columns or extra_columns:
            details = []
            if missing_columns:
                details.append(f"missing required columns: {', '.join(missing_columns)}")
            if extra_columns:
                details.append(f"unexpected columns: {', '.join(extra_columns)}")
            raise CsvInputError(f"{csv_path}: " + "; ".join(details))

        for row_number, row in enumerate(reader, start=2):
            if row is None:
                continue
            if "__extra_csv_values__" in row:
                raise CsvInputError(
                    f"{csv_path}: row {row_number}: more values than header columns"
                )

            record = {}
            for column in COLUMNS:
                name = column["name"]
                try:
                    record[name] = _convert_value(row[name], column)
                except (InvalidOperation, OverflowError, TypeError, ValueError) as error:
                    raise CsvInputError(
                        f"{csv_path}: row {row_number}, column {name!r}: {error}"
                    ) from error
            records.append(record)

    return records
