# Local development only. Change these values before exposing services beyond your machine.
POSTGRES_DB=etl_db
POSTGRES_USER=etl_user
POSTGRES_PASSWORD=local_dev_only_change_me
POSTGRES_PORT=5432

# Disposable database used only by the optional PostgreSQL integration test.
ETL_TEST_DB_USER=etl_test_user
ETL_TEST_DB_PASSWORD=local_test_only
ETL_TEST_DB_PORT=5433
